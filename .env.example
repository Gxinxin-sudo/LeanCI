# Copy this file to .env and fill secrets only on your own machine.
# Never commit .env or paste API keys into chat, logs, tests, screenshots, or docs.

# Secrets (intentionally empty)
DEEPSEEK_API_KEY=
PARITOK_API_KEY=

# Formal analysis is fail-closed through Paritok.
# "direct" and "mock" are intentionally unavailable to the formal endpoint.
LLM_PROVIDER=paritok

# Fixed model and direct-connection endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Future formal Paritok path
PARITOK_PROXY_BASE_URL=http://127.0.0.1:8080/v1
PARITOK_HEALTH_URL=http://127.0.0.1:8080/health
PARITOK_STATS_URL=http://127.0.0.1:8080/stats
PARITOK_GPU_STATUS_URL=https://www.paritok.com/api/test
PARITOK_UPSTREAM_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions
PARITOK_HEALTH_TIMEOUT_SECONDS=3
PARITOK_STATS_TIMEOUT_SECONDS=3
PARITOK_GPU_STATUS_TIMEOUT_SECONDS=10

# Baseline is for the dedicated benchmark service only.
BENCHMARK_DEEPSEEK_BASE_URL=https://api.deepseek.com
ENABLE_LIVE_BENCHMARK=false

# DeepSeek structured output
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_NETWORK_RETRIES=2
ANALYSIS_TIMEOUT_SECONDS=110
# Optional development-only invalid-output metadata. Records never contain
# model content or uploaded evidence; production rejects an enabled setting.
SAVE_INVALID_RESPONSE_DEBUG=false
DEBUG_RESPONSE_DIR=runtime/debug_responses

# Input limits
MAX_LOG_CHARACTERS=120000
MAX_REQUEST_BYTES=4194304
MAX_LOG_BYTES=2097152
MAX_UPLOAD_FILES=5
MAX_UPLOAD_FILE_BYTES=262144
MAX_UPLOAD_TOTAL_BYTES=1048576
PARITOK_CHUNK_TARGET_TOKENS=12000
ANALYSIS_CONCURRENCY=1

# Browser access and abuse controls
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_RATE_LIMIT_REQUESTS=120
ANALYZE_RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_BUCKETS=4096

# Production trust boundary. In production, all values below are mandatory.
# Set CORS to exact HTTPS frontend origins; do not put a secret in the browser.
# The TLS/OIDC gateway must strip and re-add the two internal headers only after
# authenticating the user, and the container must not be directly public.
ENVIRONMENT=development
TRUSTED_PROXY_CIDRS=
PROXY_AUTH_SHARED_SECRET=
PROXY_AUTH_HEADER=x-leanci-proxy-auth
PROXY_PRINCIPAL_HEADER=x-leanci-principal
# Gateway/Redis policy: require distributed enforcement and cap paid analyses/day.
DISTRIBUTED_RATE_LIMIT_REQUIRED=false
DAILY_ANALYSIS_REQUEST_BUDGET=0
# Redis/gateway counter TTL and operational metadata maximum retention. LeanCI
# never persists request bodies, uploaded files, model responses, or identities.
DATA_RETENTION_HOURS=24

# DeepSeek price estimate snapshot (USD per 1M tokens)
DEEPSEEK_INPUT_CACHE_MISS_USD_PER_M=0.14
DEEPSEEK_INPUT_CACHE_HIT_USD_PER_M=0.0028
DEEPSEEK_OUTPUT_USD_PER_M=0.28
PRICING_SNAPSHOT_DATE=2026-07-26

# Runtime
PORT=8000
LOG_LEVEL=INFO
